<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>rtsystems</groupId>
    <artifactId>emploismaroc</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>emploismaroc</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <lombok.version>1.18.34</lombok.version>
        <org.mapstruct.version>1.4.2.Final</org.mapstruct.version>
        <jetty.version>12.1.5</jetty.version>
        <mockito.version>5.14.2</mockito.version>
    </properties>


    <build>
        <finalName>emploismaroc</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.centoria.jobmaroc.web.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <warSourceExcludes>public/**</warSourceExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.samaxes.maven</groupId>
                <artifactId>minify-maven-plugin</artifactId>
                <version>1.7.6</version>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-utils</artifactId>
                        <version>4.0.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <!-- execution 1 pour le projet -->
                    <execution>
                        <id>project-minify</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <jsEngine>CLOSURE</jsEngine>
                            <webappSourceDir>/</webappSourceDir>
                            <webappTargetDir>/</webappTargetDir>
                            <cssSourceDir>${project.basedir}/src/main/resources/public/assets/css</cssSourceDir>
                            <cssTargetDir>${project.basedir}/src/main/resources/public/assets/css-min</cssTargetDir>
                            <cssSourceIncludes>
                                <cssSourceInclude>**/*.css</cssSourceInclude>
                            </cssSourceIncludes>
                            <cssSourceExcludes>
                                <cssSourceExclude>**/*.min.css</cssSourceExclude>
                            </cssSourceExcludes>
                            <jsSourceDir>${project.basedir}/src/main/resources/public/assets/js</jsSourceDir>
                            <jsTargetDir>${project.basedir}/src/main/resources/public/assets/js-min</jsTargetDir>
                            <jsSourceIncludes>
                                <jsSourceInclude>**/*.js</jsSourceInclude>
                            </jsSourceIncludes>
                            <jsSourceExcludes>
                                <jsSourceExclude>**/*.min.js</jsSourceExclude>
                            </jsSourceExcludes>
                            <skipMerge>true</skipMerge>
                        </configuration>
                        <goals>
                            <goal>minify</goal>
                        </goals>
                    </execution>
                    <!-- execution 2 pour le target -->
                    <execution>
                        <id>default-minify</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <verbose>true</verbose>
                            <jsEngine>CLOSURE</jsEngine>
                            <webappSourceDir>/</webappSourceDir>
                            <webappTargetDir>/</webappTargetDir>
                            <cssSourceDir>${project.basedir}/src/main/resources/public/assets/css</cssSourceDir>
                            <cssTargetDir>${project.build.directory}/classes/public/assets/css-min</cssTargetDir>
                            <cssSourceIncludes>
                                <cssSourceInclude>**/*.css</cssSourceInclude>
                            </cssSourceIncludes>
                            <cssSourceExcludes>
                                <cssSourceExclude>**/*.min.css</cssSourceExclude>
                            </cssSourceExcludes>
                            <jsSourceDir>${project.basedir}/src/main/resources/public/assets/js</jsSourceDir>
                            <jsTargetDir>${project.build.directory}/classes/public/assets/js-min</jsTargetDir>
                            <jsSourceIncludes>
                                <jsSourceInclude>**/*.js</jsSourceInclude>
                            </jsSourceIncludes>
                            <jsSourceExcludes>
                                <jsSourceExclude>**/*.min.js</jsSourceExclude>
                            </jsSourceExcludes>
                            <skipMerge>true</skipMerge>
                        </configuration>
                        <goals>
                            <goal>minify</goal>
                        </goals>
                    </execution>
                    <!-- execution 3 pour assets-theme -->
                    <execution>
                        <id>theme-minify</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <jsEngine>CLOSURE</jsEngine>
                            <webappSourceDir>/</webappSourceDir>
                            <webappTargetDir>/</webappTargetDir>
                            <cssSourceDir>${project.basedir}/src/main/resources/public/assets-theme/css</cssSourceDir>
                            <cssTargetDir>${project.basedir}/src/main/resources/public/assets-theme/css-min</cssTargetDir>
                            <cssSourceIncludes>
                                <cssSourceInclude>**/*.css</cssSourceInclude>
                            </cssSourceIncludes>
                            <cssSourceExcludes>
                                <cssSourceExclude>**/*.min.css</cssSourceExclude>
                            </cssSourceExcludes>
                            <jsSourceDir>${project.basedir}/src/main/resources/public/assets-theme/js</jsSourceDir>
                            <jsTargetDir>${project.basedir}/src/main/resources/public/assets-theme/js-min</jsTargetDir>
                            <jsSourceIncludes>
                                <jsSourceInclude>**/*.js</jsSourceInclude>
                            </jsSourceIncludes>
                            <jsSourceExcludes>
                                <jsSourceExclude>**/*.min.js</jsSourceExclude>
                            </jsSourceExcludes>
                            <skipMerge>true</skipMerge>
                        </configuration>
                        <goals>
                            <goal>minify</goal>
                        </goals>
                    </execution>
                    <!-- execution 4 pour assets-theme dans le target -->
                    <execution>
                        <id>theme-minify-target</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <verbose>true</verbose>
                            <jsEngine>CLOSURE</jsEngine>
                            <webappSourceDir>/</webappSourceDir>
                            <webappTargetDir>/</webappTargetDir>
                            <cssSourceDir>${project.basedir}/src/main/resources/public/assets-theme/css</cssSourceDir>
                            <cssTargetDir>${project.build.directory}/classes/public/assets-theme/css-min</cssTargetDir>
                            <cssSourceIncludes>
                                <cssSourceInclude>**/*.css</cssSourceInclude>
                            </cssSourceIncludes>
                            <cssSourceExcludes>
                                <cssSourceExclude>**/*.min.css</cssSourceExclude>
                            </cssSourceExcludes>
                            <jsSourceDir>${project.basedir}/src/main/resources/public/assets-theme/js</jsSourceDir>
                            <jsTargetDir>${project.build.directory}/classes/public/assets-theme/js-min</jsTargetDir>
                            <jsSourceIncludes>
                                <jsSourceInclude>**/*.js</jsSourceInclude>
                            </jsSourceIncludes>
                            <jsSourceExcludes>
                                <jsSourceExclude>**/*.min.js</jsSourceExclude>
                            </jsSourceExcludes>
                            <skipMerge>true</skipMerge>
                        </configuration>
                        <goals>
                            <goal>minify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${org.mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Mockito en agent JVM (évite le self-attach déprécié sur JDK récents).
                         Si vous ajoutez JaCoCo, préfixez par ${argLine} (prepare-agent) au lieu de cette ligne seule. -->
                    <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                    <environmentVariables>
                        <EM_ENV>test</EM_ENV>
                    </environmentVariables>
                    <excludes>
                        <exclude>**/selenium/**/*Test.java</exclude>
                        <exclude>**/playwright/**/*Test.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.antlr</groupId>
